pipeline {
    agent { label 'minato-ci' }

    environment {
        NVM_DIR       = "/home/minato/.nvm"
        DEPLOY_SCRIPT = "ci/deploy-wrapper.sh"
        BUILD_DIR     = "/opt/jenkins/Minato-packaging"
        NODE_VERSION  = "18.20.2"
        RUBY_VERSION  = "3.2.2"

        # ✅ Secure DB connection details from Jenkins credentials
        DB_HOST                   = "192.168.0.200"
        MINATO_DATABASE_USERNAME  = credentials('minato')
        MINATO_DATABASE_PASSWORD  = credentials('1SW-streamwide')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'feature/quasar-spa',
                    url: 'git@github.com:cebik16-2/minato.git'
            }
        }

        stage('Prepare Build Directory') {
            steps {
                sh "bash ci/steps/prepare_build.sh"
            }
        }

        stage('Verify Node.js') {
            steps {
                sh "bash ci/steps/verify_node.sh ${NODE_VERSION}"
            }
        }

        stage('Verify Ruby') {
            steps {
                sh "bash ci/steps/verify_ruby.sh ${RUBY_VERSION}"
            }
        }

        stage('Build Frontend') {
            steps {
                sh "bash ci/steps/build_frontend.sh ${NODE_VERSION}"
            }
        }

        stage('Build Backend') {
            steps {
                sh "bash ci/steps/build_backend.sh ${RUBY_VERSION}"
            }
        }

        stage('Deploy to API Server') {
            steps {
                sh """
                    echo "[DEPLOY] Starting deployment to production..."
                    export MINATO_DATABASE_USERNAME=${MINATO_DATABASE_USERNAME}
                    export MINATO_DATABASE_PASSWORD=${MINATO_DATABASE_PASSWORD}
                    export DB_HOST=${DB_HOST}
                    bash ${DEPLOY_SCRIPT} production
                """
            }
        }

        stage('Post-Deploy Verification') {
            parallel {
                stage('Check API Health') {
                    steps {
                        sh """
                            echo "[VERIFY] Checking API health..."
                            curl -v http://minato-api:3000/health || { 
                                echo '[ERROR] API health check failed'; exit 1; 
                            }
                        """
                    }
                }
                stage('Check Frontend') {
                    steps {
                        sh """
                            echo "[VERIFY] Checking frontend..."
                            curl -v http://minato.stevebytesnest.com || { 
                                echo '[ERROR] Frontend check failed'; exit 1; 
                            }
                        """
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "[ROLLBACK] Deployment failed. Rollback can be implemented here."
        }
    }
}
