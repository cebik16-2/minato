pipeline {
    agent { label 'minato-ci' }

    environment {
        NVM_DIR       = "/home/minato/.nvm"
        DEPLOY_SCRIPT = "ci/deploy-wrapper.sh"
        BUILD_DIR     = "/opt/jenkins/Minato-packaging"
        NODE_VERSION  = "18.20.2"
        RUBY_VERSION  = "3.2.2"

        DB_HOST                  = "192.168.0.200"
        MINATO_DATABASE_USERNAME = credentials('minato-db-username')
        MINATO_DATABASE_PASSWORD = credentials('minato-db-password')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'feature/quasar-spa',
                    url: 'git@github.com:cebik16-2/minato.git'
            }
        }

        stage('Prepare Build Directory') {
            steps {
                sh "bash ci/steps/prepare_build.sh"
            }
        }

        stage('Verify Node.js') {
            steps {
                sh "bash ci/steps/verify_node.sh ${NODE_VERSION}"
            }
        }

        stage('Verify Ruby') {
            steps {
                sh "bash ci/steps/verify_ruby.sh ${RUBY_VERSION}"
            }
        }

        stage('Build Frontend') {
            steps {
                withEnv([
                    'VITE_API_URL=http://minato-api:3000'
                ]) {
                    sh '''
                        cd client
                        npm install
                        npm run build
                    '''
                }
            }
        }


        stage('Build Backend') {
            steps {
                sh """
                    export DB_HOST=${DB_HOST}
                    export MINATO_DATABASE_USERNAME=${MINATO_DATABASE_USERNAME}
                    export MINATO_DATABASE_PASSWORD=${MINATO_DATABASE_PASSWORD}
                    bash ci/steps/build_backend.sh ${RUBY_VERSION}
                """
            }
        }

        stage('Deploy to API Server') {
            steps {
                withCredentials([
                sshUserPrivateKey(credentialsId: 'minato-ssh', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                usernamePassword(credentialsId: 'pg-minato', usernameVariable: 'MINATO_DATABASE_USERNAME', passwordVariable: 'MINATO_DATABASE_PASSWORD'),
                string(credentialsId: 'db-host', variable: 'DB_HOST'),
                string(credentialsId: 'rails-secret-key-base', variable: 'SECRET_KEY_BASE')
                ]) {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail

                    # Hardening & visibility
                    chmod 600 "$SSH_KEY"

                    # Avoid Groovy interpolation; use env vars in the shell only
                    export SSH_OPTIONS="-i $SSH_KEY -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

                    echo "[CI] Running deploy-wrapper..."
                    # Mask the DB password in logs while still showing commands (-x)
                    set -x
                    DB_HOST="$DB_HOST" \
                    MINATO_DATABASE_USERNAME="$MINATO_DATABASE_USERNAME" \
                    MINATO_DATABASE_PASSWORD="$MINATO_DATABASE_PASSWORD" \
                    SECRET_KEY_BASE="$SECRET_KEY_BASE" \
                    SSH_OPTIONS="$SSH_OPTIONS" \
                    bash -x ci/deploy/deploy-wrapper.sh 2>&1 | sed -E "s/${MINATO_DATABASE_PASSWORD//\//\\/}/****/g"
                    set +x
                '''
                }
            }
        }


        stage('Post-Deploy Verification') {
            parallel {
                stage('Check API Health') {
                    steps {
                        sh """
                            echo "[VERIFY] Checking API health..."
                            curl -v http://minato-api:3000/health || {
                                echo '[ERROR] API health check failed'; exit 1;
                            }
                        """
                    }
                }
                stage('Check Frontend') {
                    steps {
                        sh """
                            echo "[VERIFY] Checking frontend..."
                            curl -v http://minato.stevebytesnest.com || {
                                echo '[ERROR] Frontend check failed'; exit 1;
                            }
                        """
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "[ROLLBACK] Deployment failed. Add rollback steps here if needed."
        }
    }
}
